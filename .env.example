# ============================================================
# Viviantourr — variáveis de ambiente
# Copie este arquivo para ".env.local" e preencha quando
# for conectar o Supabase (guia completo no README).
# Sem estas variáveis, o app roda em MODO DEMONSTRAÇÃO.
# ============================================================

# Painel do Supabase → Project Settings → API
# No Supabase novo, a "Publishable key" (sb_publishable_...) substitui a
# antiga anon key — cole o valor dela em NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço (service_role) — NUNCA exponha no cliente.
# Usada apenas no servidor para: sincronização iCal, rotinas de cron
# e operações administrativas.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo obrigatório para proteger a rota de cron /api/cron/sync-calendars
CRON_SECRET=

# URL pública canônica do site (usada em redirecionamentos, canonical e previews de compartilhamento).
# Em produção, use o domínio final com https, por exemplo: https://www.viviantourr.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp geral de atendimento, no formato 5522999999999 (opcional se cada fornecedor cadastrar o próprio WhatsApp)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Gateway de pagamento (opcional) — Mercado Pago Checkout Pro.
# Sem esta chave, o pagamento é confirmado manualmente pelo cliente.
MERCADOPAGO_ACCESS_TOKEN=
