{
  "name": "viviantourr",
  "version": "0.1.0",
  "private": true,
  "description": "Viviantourr — marketplace de turismo multi-fornecedor de Arraial do Cabo, RJ",
  "scripts": {
    "check:encoding": "node scripts/check-text-encoding.mjs",
    "dev": "next dev",
    "build": "npm run validate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "node --test tests/encoding.test.mjs tests/calendar.test.cjs tests/integrity.test.cjs tests/cadastur.test.cjs",
    "validate": "npm run check:encoding && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "date-fns": "^3.6.0",
    "ical.js": "2.2.1",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  }
}
